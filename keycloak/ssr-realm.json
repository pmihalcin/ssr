{
  "realm": "ssr",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Tester",
      "realmRoles": ["default-roles-ssr"],
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "csr-bff",
      "name": "CSR app BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "csr-bff-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5000/*"],
      "webOrigins": ["http://localhost:5000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5000/*"
      },
      "protocolMappers": [
        {
          "name": "orders-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "orders-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "ssr-app",
      "name": "SSR app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ssr-app-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "orders-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "orders-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "dev-cli",
      "name": "Local development token client (password grant, never used by the apps)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "orders-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "orders-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ]
}
